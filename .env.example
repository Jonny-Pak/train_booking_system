# Copy to .env at repository root. Replace every placeholder locally.
# Render/prod uses SPRING_DATASOURCE_URL/USERNAME/PASSWORD; see docs/render-env.example.
# Do not add empty SPRING_DATASOURCE_* values here: they override the local DB_* values.
DB_URL=jdbc:postgresql://localhost:5432/ticket_booking
DB_USERNAME=ticket_booking_app
DB_PASSWORD=replace_with_local_password
SERVER_PORT=8080
JWT_SECRET=replace_with_base64_of_at_least_32_random_bytes
JWT_ACCESS_TOKEN_SECONDS=900
BOOKING_HOLD_SECONDS=600
BOOKING_EXPIRY_ENABLED=true
BOOKING_EXPIRY_POLL_MILLISECONDS=30000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_SECONDS=1800
# Local SMTP capture server; configure your SMTP provider before using real mail.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@localhost
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# VNPAY Sandbox only. IPN URL must be reachable publicly and registered with VNPAY.
VNPAY_ENABLED=false
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment/return
# Register this URL in your VNPAY merchant settings; it is not sent as a pay parameter.
VNPAY_IPN_URL=
# Optional local callback relay, exposed through a Cloudflare Tunnel (not the Vite server).
VNPAY_CALLBACK_PORT=8787
VNPAY_CALLBACK_BACKEND_URL=http://127.0.0.1:8080
# Use exactly the origin where the browser logged in, to keep sessionStorage after Return.
VNPAY_CALLBACK_FRONTEND_URL=http://localhost:5173
