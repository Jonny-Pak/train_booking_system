# Copy to .env at repository root. Replace every placeholder locally.
DB_URL=jdbc:postgresql://localhost:5432/ticket_booking
DB_USERNAME=ticket_booking_app
DB_PASSWORD=replace_with_local_password
SERVER_PORT=8080
JWT_SECRET=replace_with_base64_of_at_least_32_random_bytes
JWT_ACCESS_TOKEN_SECONDS=900
BOOKING_HOLD_SECONDS=600
BOOKING_EXPIRY_ENABLED=true
BOOKING_EXPIRY_POLL_MILLISECONDS=30000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
